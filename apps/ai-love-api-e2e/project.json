{
  "name": "ai-love-api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["ai-love-api"],
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/ai-love-api-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["ai-love-api:build", "ai-love-api:serve"]
    }
  }
}
