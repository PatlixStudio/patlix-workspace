# patlix-api environment configuration
# Copy to .env and adjust values for your machine.

# --- Server ---
PORT=3000

# --- PostgreSQL (Windows Docker Desktop instance) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=patlix
DB_PASSWORD=patlix
DB_NAME=patlix

# --- Auth ---
JWT_SECRET=patlix-dev-secret-change-me
JWT_EXPIRES_IN=7d

# --- Seed ---
SEED_ADMIN_EMAIL=admin@patlix.dev
SEED_ADMIN_PASSWORD=admin123
